# Copy this file to .env and adjust for your machine.
# .env is gitignored so real secrets never get committed.

# Postgres connection string.
# Local dev (Postgres.app / Homebrew, current OS user, no password):
#   postgres://YOUR_USER@localhost:5432/expense_tracker?sslmode=disable
# Production: use the managed database URL, kept in a secret store — never here.
DATABASE_URL=postgres://YOUR_USER@localhost:5432/expense_tracker?sslmode=disable

# Secret used to sign JWTs. Generate one with:  openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret
